#!/usr/bin/env bash
# Host side of the AI and page-render request queues: takes one queued request from the app container, runs it in a
# one-off tool-less Sessioneer session (`--no-tools --wait` prints the final reply) and hands the reply back. Run on demand;
# `--loop` keeps polling. Needs docker, jq and `sessioneer` with `--wait` and `--no-tools` on the host; page renders also need node with
# `npm install` run in tools/render and a Chromium (RENDER_CHROME, default: newest in ~/.cache/ms-playwright).
set -euo pipefail

CONTAINER="${JACKER_CONTAINER:-jacker-app}"
TIMEOUT="${AI_BRIDGE_TIMEOUT:-180}"
RENDER_TIMEOUT="${RENDER_TIMEOUT_MS:-30000}"; RENDER_TIMEOUT=$((RENDER_TIMEOUT / 1000))
RENDER_SCRIPT="$(dirname "$(readlink -f "$0")")/../tools/render/render.mjs"
# OpenCode has no --no-tools: shell, edits, web, subagents and skills are denied and reads stay inside the empty work directory; its config dir is empty so the global MCP servers are not loaded. (Denying "read" or setting "tools" makes this version hang.)
OPENCODE_NO_TOOLS='{"permission":{"bash":"deny","edit":"deny","webfetch":"deny","websearch":"deny","task":"deny","skill":"deny","external_directory":"deny"}}'
WORKDIR="$(mktemp -d)"; mkdir "$WORKDIR/.config"
trap 'rm -rf "$WORKDIR"' EXIT
artisan() { docker exec -i --user www-data "$CONTAINER" php artisan "$@"; }

render_one() {
    local job id url text errfile
    job="$(artisan render:claim)"
    [ -n "$job" ] || return 1
    id="$(jq -r .id <<<"$job")"; url="$(jq -r .url <<<"$job")"
    errfile="$(mktemp)"
    if text="$(timeout "$((RENDER_TIMEOUT + 30))" node "$RENDER_SCRIPT" "$url" 2>"$errfile")" && [ -n "$text" ]; then
        artisan render:complete "$id" <<<"$text"
    else
        artisan render:complete "$id" --fail="$(tail -n1 "$errfile" | cut -c1-300)"
    fi
    rm -f "$errfile"
}

# Reading a page tries each agent of the chain from config (ai.chain) in order until one returns a JSON object, like scoring below. The model reads
# untrusted page text, so every agent runs without tools (run_agent); the chain comes from config, never from the request or the page.
extract_one() {
    local job id prompt agent model reply n i
    job="$(artisan ai:claim)"
    [ -n "$job" ] || return 1
    id="$(jq -r .id <<<"$job")"; prompt="$(jq -r .prompt <<<"$job")"; n="$(jq '.chain | length' <<<"$job")"
    for ((i = 0; i < n; i++)); do
        agent="$(jq -r ".chain[$i].agent" <<<"$job")"; model="$(jq -r ".chain[$i].model" <<<"$job")"
        [[ "$agent" =~ ^(claude|codex|opencode)$ ]] && [[ "$model" =~ ^[A-Za-z0-9][A-Za-z0-9._:/-]*$ ]] || continue
        if reply="$(run_agent "$agent" "$model" <<<"$prompt" 2>/dev/null)" && [[ "$reply" == *"{"* ]]; then
            artisan ai:complete "$id" --agent="$agent" --model="$model" <<<"$reply"
            return 0
        fi
    done
    artisan ai:complete "$id" --fail="no agent in the chain returned a usable reply"
}

# Runs one prompt (stdin) through one agent with no way to act on the listing text; prints the reply. Sessioneer only launches claude,
# so codex and opencode run through their own CLIs (read-only sandbox / empty directory).
run_agent() {
    local agent="$1" model="$2" out
    case "$agent" in
        claude)
            out="$(mktemp)"
            timeout "$((TIMEOUT + 30))" sessioneer --wait --no-tools --timeout "$TIMEOUT" --agent claude --model "$model" --workdir "$WORKDIR" - 2>"$out" || { rm -f "$out"; return 1; }
            [ -z "$(head -n1 "$out")" ] || sessioneer --kill "$(head -n1 "$out")" >/dev/null 2>&1 || true
            rm -f "$out" ;;
        codex)
            out="$(mktemp)"
            timeout "$((TIMEOUT + 30))" codex exec --ignore-user-config --ignore-rules --sandbox read-only --skip-git-repo-check --ephemeral -C "$WORKDIR" -m "$model" -o "$out" - >/dev/null \
                && cat "$out"
            rm -f "$out" ;;
        opencode) XDG_CONFIG_HOME="$WORKDIR/.config" OPENCODE_CONFIG_CONTENT="$OPENCODE_NO_TOOLS" timeout "$((TIMEOUT + 30))" opencode run --pure --dir "$WORKDIR" -m "$model" "$(cat)" ;;
        *) return 1 ;;
    esac
}

# Scoring tries each agent of the chain from config in order until one returns a JSON object (no quota or an error falls through).
score_one() {
    local job id prompt agent model reply n i
    job="$(artisan score:claim)"
    [ -n "$job" ] || return 1
    id="$(jq -r .id <<<"$job")"; prompt="$(jq -r .prompt <<<"$job")"; n="$(jq '.chain | length' <<<"$job")"
    for ((i = 0; i < n; i++)); do
        agent="$(jq -r ".chain[$i].agent" <<<"$job")"; model="$(jq -r ".chain[$i].model" <<<"$job")"
        [[ "$agent" =~ ^(claude|codex|opencode)$ ]] && [[ "$model" =~ ^[A-Za-z0-9][A-Za-z0-9._:/-]*$ ]] || continue
        if reply="$(run_agent "$agent" "$model" <<<"$prompt" 2>/dev/null)" && [[ "$reply" == *"{"* ]]; then
            artisan score:complete "$id" --agent="$agent" --model="$model" <<<"$reply"
            return 0
        fi
    done
    artisan score:complete "$id" --fail="no agent in the chain returned a usable reply"
}

work_one() {
    render_one || extract_one || score_one
}

if [ "${1:-}" = "--loop" ]; then
    while true; do work_one || sleep 5; done
else
    while work_one; do :; done
fi
