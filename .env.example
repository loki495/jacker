APP_NAME="Job tracker"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8096
APP_PORT=8096
APP_UID=1000
APP_GID=1000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=UTC
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
ALLOWED_HOSTS=localhost,127.0.0.1
TRUSTED_PROXIES=
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
DB_CONNECTION=sqlite
DB_FOREIGN_KEYS=true
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CSV_MAX_BYTES=5242880
CSV_MAX_ROWS=1000
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log
MAIL_FROM_ADDRESS=jacker@example.invalid
MAIL_FROM_NAME="${APP_NAME}"
VITE_APP_NAME="${APP_NAME}"

# Optional SDK backend. Bridge stays the default; credentials live only here.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_EXTRACT_DRIVER=bridge
AI_EXTRACT_PROVIDER=anthropic
AI_EXTRACT_MODEL=claude-haiku-4-5
AI_SCORE_DRIVER=bridge
AI_SCORE_PROVIDER=anthropic
AI_SCORE_MODEL=claude-haiku-4-5
AI_LETTER_DRIVER=bridge
AI_LETTER_PROVIDER=anthropic
AI_LETTER_MODEL=claude-haiku-4-5

# Optional similarity experiment; enable in Settings only when ready to send content.
EMBEDDINGS_PROVIDER=openai
EMBEDDINGS_MODEL=text-embedding-3-small
EMBEDDINGS_DIMENSIONS=1536
